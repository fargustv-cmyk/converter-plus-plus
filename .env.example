# Скопируйте этот файл в .env и заполните значения
# Создайте бота в @BotFather и вставьте сюда его токен.
# Без токена приложение запустится в dev-режиме (Pro-фичи открыты автоматически).
BOT_TOKEN=

# Порт, на котором будет работать сервер
PORT=3000

# Цена разблокировки Pro в Telegram Stars
STARS_PRICE=399

# Telegram кладёт это значение в заголовок X-Telegram-Bot-Api-Secret-Token
# на каждый webhook-апдейт. Без него любой, знающий URL вебхука, мог бы
# отправить поддельный successful_payment и активировать Pro бесплатно.
# Сгенерируй: openssl rand -hex 24
WEBHOOK_SECRET=

# Картинка-превью для invoice (рекомендуется PNG/JPG, без SVG).
# По умолчанию /public/invoice-photo.png который раздаёт сервер.
APP_PHOTO_URL=

# Список Telegram user ID через запятую — admin override (всегда Pro).
PRO_USER_IDS=

# Upstash Redis (опционально — без него платежи живут только в памяти).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
